2. Data Structures & Algorithms

START
    undoStack = new Stack()
    document = ""
    
    function insertText(position, text)
        undoStack.push(["DELETE", position, text.length])
        document = document.substring(0, position) + text + document.substring(position)
    
    function deleteText(position, length)
        deletedText = document.substring(position, position + length)
        undoStack.push(["INSERT", position, deletedText])
        document = document.substring(0, position) + document.substring(position + length)
    
    function undo()
        if undoStack.isEmpty()
            print "Nothing to undo"
            return
        
        operation = undoStack.pop()
        
        if operation[0] == "DELETE"
            document = document.substring(0, operation[1]) + document.substring(operation[1] + operation[2])
        
        else if operation[0] == "INSERT"
            document = document.substring(0, operation[1]) + operation[2] + document.substring(operation[1])
END


3. Collections, Generics, Streams

START
    studentScores = new HashMap<String, Integer>()
    
    studentScores.put("Alice", 85)
    studentScores.put("Bob", 92)
    studentScores.put("Charlie", 78)
    studentScores.put("David", 95)
    studentScores.put("Eva", 88)
    
    highestScorer = studentScores.entrySet()
                               .stream()
                               .max((a, b) -> a.getValue().compareTo(b.getValue()))
                               .get()
    
    print "Highest scorer: " + highestScorer.getKey() + " with score: " + highestScorer.getValue()
END